---
// Trust: the Privacy Policy in one line per topic. Every line must stay true
// to privacy.astro; change that page first, then this one.
import Base from '../layouts/Base.astro';
import Marker from '../components/Marker.astro';

const items = [
  {
    term: 'account',
    text: 'there is none. Pocket works without a sign-up, a name or an email address.',
  },
  {
    term: 'your data',
    text: 'mail, notes, calendar and clipboard stay on your Mac. we never receive them.',
  },
  {
    term: 'our server',
    text: 'it knows one thing: a hashed ID of your Mac and the day your Trial started.',
  },
  {
    term: 'assistant',
    text: 'off until you connect your own AI provider. your messages go straight to it, not through us.',
  },
  {
    term: 'training',
    text: 'we never train AI on your data. what your AI provider does is set by its own policy.',
  },
  {
    term: 'sharing',
    text: 'we don’t sell your data. there are no ads, no analytics and no crash reporting.',
  },
  {
    term: 'background',
    text: 'Pocket doesn’t record your screen or read what you type in other apps. the microphone is on only while you dictate.',
  },
  {
    term: 'payments',
    text: 'Polar handles checkout. we never see your card.',
  },
  {
    term: 'updates',
    text: 'Pocket checks once a day and asks before installing. every update is signed, every release notarized by Apple.',
  },
  {
    term: 'deletion',
    text: 'drag Pocket to the Trash, and write to us to delete your Trial entry.',
  },
  {
    term: 'certifications',
    text: 'no SOC 2 or ISO 27001. Pocket is made by one person, and the best protection we have is keeping almost nothing.',
  },
];
---

<Base
  title="Trust"
  description="How Pocket treats your data, in one line per topic."
>
  <section class="container page">
    <Marker shape="square" play />
    <h1 class="h indent">Trust</h1>
    <div class="indent prose">
    <p class="label muted">Last updated: November 23, 2026</p>

    <p>The short version of how Pocket treats your data.</p>

    <dl class="trust">
      {
        items.map(({ term, text }) => (
          <>
            <dt>{term}</dt>
            <dd>{text}</dd>
          </>
        ))
      }
    </dl>

    <p>
      The full details are in the <a href="/privacy">Privacy Policy</a>. Questions go to
      <a href="mailto:support@pocketwidget.tech">support@pocketwidget.tech</a>.
    </p>
    </div>
  </section>
</Base>

<style>
  .trust {
    margin: 0 0 var(--s-4);
  }

  .trust dd {
    margin: 0 0 var(--s-3);
    padding-left: var(--s-3);
    border-left: 1px solid var(--line-strong);
  }
</style>
