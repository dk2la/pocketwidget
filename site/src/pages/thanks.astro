---
// Where Polar sends a buyer after payment (the checkout link's success URL):
// the thank-you written on one wide picture at the top, so it is the first
// thing seen, then the three steps from the email to an activated Pocket.
// Everything fits the first screen of a 14-inch MacBook. Not linked from the
// site and kept out of search results.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import sky from '../assets/pictures/sky.png';
import { downloadURL, licensePortalURL, supportEmail } from '../config';
const steps = [
  {
    title: 'open the email',
    text: 'Polar sent your License key to the address you paid with. it can take a minute.',
  },
  {
    title: 'copy the key',
    text: 'it starts with POCKET. one key works on up to 3 of your Macs.',
  },
  {
    title: 'paste it in pocket',
    text: 'open pocket’s settings, choose Enter License key, paste and press Activate.',
  },
];
---

<Base title="Thanks" description="Thanks for buying Pocket. Here is how to enter your License key.">
  <meta slot="head" name="robots" content="noindex" />

  <section class="section container thanks">
    <div class="thanks__hero">
      <Picture
        src={sky}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[700, 1088, 1376]}
        sizes="(max-width: 1151px) calc(100vw - 2 * var(--gutter)), 1088px"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="thanks__bg"
      />
      <div class="thanks__text">
        <h1 class="thanks__title">thanks for buying pocket</h1>
        <p class="thanks__lede">your License key is on its way to your inbox.</p>
      </div>
    </div>

    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="step">
            <span class="label muted">step {i + 1}</span>
            <h2 class="strong">{step.title}</h2>
            <p class="body step__text">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="thanks__cta">
      <a class="btn btn--light" href={downloadURL} download>download pocket</a>
      <a class="btn btn--quiet" href={licensePortalURL}>manage license</a>
    </div>
    <p class="label muted thanks__help">
      no email after a few minutes? check spam, or write to
      <a href={`mailto:${supportEmail}`}>{supportEmail}</a>.
    </p>
  </section>
</Base>

<style>
  .thanks {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--s-5);
    text-align: center;
  }

  /* One wide picture with the thank-you printed on it, in the ground colour. */
  .thanks__hero {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 320px;
    overflow: hidden;
    background: var(--paper);
    color: var(--ground);
  }

  .thanks__hero :global(.thanks__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .thanks__text {
    position: relative;
    padding: var(--s-5);
  }

  .thanks__title {
    font-size: 56px;
    font-weight: 600;
    line-height: 64px;
    letter-spacing: -0.03em;
  }

  .thanks__lede {
    margin-top: var(--s-2);
    font-size: 22px;
    font-weight: 400;
    line-height: 28px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-3);
    width: 100%;
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding: var(--s-4) var(--s-5);
    background: var(--card);
  }

  .step__text {
    color: var(--muted);
  }

  .thanks__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .thanks__help {
    margin-top: var(--s-3);
  }

  @media (max-width: 899px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 699px) {
    .thanks__hero {
      height: 280px;
    }

    .thanks__title {
      font-size: 36px;
      line-height: 40px;
    }

    .thanks__lede {
      font-size: 18px;
      line-height: 24px;
    }
  }
</style>
