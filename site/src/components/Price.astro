---
// "Pay once, keep it": two steps side by side in one frame. Step 1 is the
// Trial with the Download button, step 2 is the License with the price and
// the Buy button. Each column ends with its button, so the buttons line up.
// The accent colour appears here only as the dot before the launch-price note
// (and on the Buy button's hover, from global.css).
//
// src/scripts/motion.ts sets `data-wait` on `.offer` while it is below the
// fold and removes it when the price is seen: the regular price is struck and
// the launch price takes its place.
import Marker from './Marker.astro';
import { checkoutURL, downloadURL, launchPriceEnds, price, salesOpen } from '../config';
---

<section class="section container">
  <Marker shape="diamond" />
  <h2 class="h indent">pay once<br />keep it</h2>
  <p class="lede indent section__lede">
    use pocket for 7 days with everything switched on. if it earns its place on your screen,
    buy it once and it’s yours.
  </p>

  <div class="indent">
    <div class="offer" id="plan">
      <article class="offer__col">
        <p class="label muted offer__step">01 / try</p>
        <h3 class="strong">Trial</h3>
        <p class="offer__price">
          <span class="offer__big">7 days</span>
          <span class="label muted">free</span>
        </p>
        <p class="label muted offer__note">starts the first time you open pocket</p>
        <ul class="offer__facts body">
          <li>every feature switched on</li>
          <li>starting it needs an internet connection</li>
          <li>when it ends, pocket locks until you enter a License key. your settings stay</li>
        </ul>
        <a class="btn btn--quiet btn--wide offer__btn" href={downloadURL} download>
          download and start the Trial
        </a>
      </article>

      <article class="offer__col">
        <p class="label muted offer__step">02 / buy</p>
        <h3 class="strong">License</h3>
        <p class="offer__price" id="price">
          <span class="offer__big offer__now">{price.launch}</span>
          <s class="offer__was">{price.regular}</s>
        </p>
        <p class="label muted offer__note">
          <span class="offer__dot" aria-hidden="true"></span>launch price until {launchPriceEnds}
        </p>
        <ul class="offer__facts body">
          <li>one payment, no subscription</li>
          <li>one License key for up to 3 of your Macs</li>
          <li>refund within 14 days if the License key was never activated</li>
        </ul>
        <a
          class="btn btn--light btn--wide offer__btn"
          href={salesOpen ? checkoutURL : '#presale'}
          data-presale={salesOpen ? undefined : ''}
        >
          buy pocket <span class="btn__price">{price.launch}</span>
        </a>
      </article>
    </div>

    <p class="label muted offer__fine">
      sold by dk2la. payment is handled by Polar. tax is added at checkout where it applies.
    </p>
  </div>
</section>

<style>
  /* Two equal columns, split by a hairline (the frame's background shows
     through the 1px gap). */
  .offer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .offer__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--s-5);
    background: var(--card);
  }

  .offer__step {
    margin-bottom: var(--s-4);
  }

  .offer__price {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-top: var(--s-3);
    white-space: nowrap;
  }

  .offer__big {
    font-size: 56px;
    font-weight: 600;
    line-height: 64px;
    letter-spacing: -0.03em;
  }

  .offer__note {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    min-height: 22px;
  }

  .offer__dot {
    width: 8px;
    height: 8px;
    flex: none;
    background: var(--accent);
  }

  .offer__facts {
    margin: var(--s-5) 0 var(--s-6);
    padding: 0;
    list-style: none;
  }

  .offer__facts li {
    position: relative;
    padding: var(--s-2) 0 var(--s-2) var(--s-4);
    border-top: 1px solid var(--line);
  }

  .offer__facts li:last-child {
    border-bottom: 1px solid var(--line);
  }

  /* A short dash instead of a bullet. */
  .offer__facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--s-2) + 13px);
    width: 10px;
    height: 1px;
    background: var(--muted);
  }

  /* Pinned to the bottom, so both buttons sit on one line. */
  .offer__btn {
    margin-top: auto;
    height: auto;
    min-height: var(--u);
    white-space: normal;
  }

  .offer__fine {
    margin-top: var(--s-4);
  }

  /* ---- the price: the regular one is struck, the launch one arrives ---- */

  .offer__now {
    transition:
      opacity 300ms ease-out 700ms,
      transform 400ms var(--ease-out) 700ms;
  }

  /* The regular price. The strike is a drawn line, so it can be drawn in. */
  .offer__was {
    position: relative;
    font-size: 28px;
    font-weight: 300;
    line-height: 32px;
    text-decoration: none;
    color: var(--muted);
    transform-origin: 0 78%;
    transition:
      color 450ms ease-out 500ms,
      transform 450ms var(--ease-out) 500ms;
  }

  .offer__was::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 52%;
    height: 1px;
    background: currentColor;
    transform-origin: 0 0;
    transition: transform 250ms var(--ease-out) 200ms;
  }

  /* Before: the regular price stands, large, where the launch price will be.
     `--shift` is set by the script (the width of the launch price + the gap). */
  .offer[data-wait] .offer__now {
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }

  .offer[data-wait] .offer__was {
    color: var(--text);
    transform: translate3d(var(--shift, 0px), 0, 0) scale(2);
  }

  .offer[data-wait] .offer__was::after {
    transform: scaleX(0);
  }

  @media (max-width: 799px) {
    .offer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 379px) {
    .offer__col {
      padding: var(--s-4);
    }

    .offer__big {
      font-size: 48px;
    }
  }
</style>
